diff --git a/challenges/train.sh b/challenges/train.sh
new file mode 100755
index 0000000..0e2103a
--- /dev/null
+++ b/challenges/train.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+# DeepSeek-V2-Lite 5-step smoke training with torchtitan.
+
+set -euo pipefail
+source torchtitan/.venv/bin/activate
+
+OUTPUT=artifacts/train-$(date +%Y%m%d-%H%M%S).log
+mkdir -p $(dirname $OUTPUT) ; exec > >(tee -a $OUTPUT) 2>&1
+trap 'echo "exit-time: $(date +%Y%m%d-%H%M%S)" >> "$OUTPUT"' EXIT INT TERM
+
+rm -rf /tmp/torchtitan
+
+LAUNCH_ARGS=()
+LAUNCH_ARGS+=(--nnodes=${SLURM_NNODES:-1} --node-rank=${SLURM_NODEID:-0} --nproc-per-node=gpu)
+LAUNCH_ARGS+=(--rdzv-backend=c10d --rdzv-endpoint=${SLURM_LAUNCH_NODE_IPADDR:-localhost}:15213)
+LAUNCH_ARGS+=(--local-ranks-filter=6 --role=rank --tee=3)
+
+export OMP_NUM_THREADS=8; export PYTHONUNBUFFERED=1; export PYTHONPATH=$PWD/torchtitan
+torchrun ${LAUNCH_ARGS[@]} -m torchtitan.train --module deepseek_v3 --config deepseek_v2_lite_smoke
