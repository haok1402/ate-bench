@@ -0,0 +1,37 @@
+from torchtitan.components.loss import build_cross_entropy_loss
+from torchtitan.components.optimizer import register_moe_load_balancing_hook
+from torchtitan.distributed.pipeline_parallel import pipeline_llm
+from torchtitan.protocols.model_spec import ModelSpec
+
+from ..deepseek_v3 import (
+    deepseekv3_configs,
+    DeepSeekV3Model,
+    DeepSeekV3StateDictAdapter,
+    parallelize_deepseekv3,
+)
+
+__all__ = [
+    "parallelize_deepseekv3",
+    "DeepSeekV3Model",
+    "deepseekv2_configs",
+    "model_registry",
+]
+
+
+deepseekv2_configs = {"V2-Lite": deepseekv3_configs["16B"]}
+
+
+def model_registry(flavor: str) -> ModelSpec:
+    """
+    Register the DeepSeek-V2 model.
+    """
+    return ModelSpec(
+        name="deepseek_v2",
+        flavor=flavor,
+        model=deepseekv2_configs[flavor],
+        parallelize_fn=parallelize_deepseekv3,
+        pipelining_fn=pipeline_llm,
+        build_loss_fn=build_cross_entropy_loss,
+        post_optimizer_build_fn=register_moe_load_balancing_hook,
+        state_dict_adapter=DeepSeekV3StateDictAdapter,
+    )
diff --git a/torchtitan/models/deepseek_v2/config_registry.py b/torchtitan/models/deepseek_v2/config_registry.py
new file mode 100644
index 0000000..5dd9344
--- /dev/null
+++ b/torchtitan/models/deepseek_v2/config_registry.py
@@ -0,0 +1,41 @@
+from torchtitan.components.lr_scheduler import LRSchedulersContainer
+from torchtitan.components.metrics import MetricsProcessor
+from torchtitan.components.optimizer import OptimizersContainer
+from torchtitan.config import (
+    ActivationCheckpointConfig,
+    CompileConfig,
+    ParallelismConfig,
+    TrainingConfig,
+)
+from torchtitan.hf_datasets.text_datasets import HuggingFaceTextDataLoader
+from torchtitan.trainer import Trainer
+
+from . import model_registry
+
+
+def deepseek_v2_lite() -> Trainer.Config:
+    """
+    DeepSeek-V2-Lite (~16B total / 2.4B active).
+    """
+    return Trainer.Config(
+        hf_assets_path="checkpoints/deepseek-v2-lite",
+        metrics=MetricsProcessor.Config(log_freq=1, disable_color_printing=True),
+        model_spec=model_registry("V2-Lite"),
+        dataloader=HuggingFaceTextDataLoader.Config(dataset="dclm"),
+        optimizer=OptimizersContainer.Config(lr=1e-4),
+        lr_scheduler=LRSchedulersContainer.Config(warmup_steps=0, min_lr_factor=1.0),
+        training=TrainingConfig(
+            local_batch_size=128,
+            global_batch_size=1024,
+            seq_len=2048,
+            steps=64,
+        ),
+        parallelism=ParallelismConfig(
+            pipeline_parallel_degree=4,
+            pipeline_parallel_schedule="Interleaved1F1B",
+            data_parallel_shard_degree=-1,
+            expert_parallel_degree=2,
+        ),
+        activation_checkpoint=ActivationCheckpointConfig(mode="none"),
+        compile=CompileConfig(enable=True),
+    )
