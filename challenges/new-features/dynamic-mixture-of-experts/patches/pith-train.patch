diff --git a/challenges/train.sh b/challenges/train.sh
new file mode 100755
index 0000000..dbcfc34
--- /dev/null
+++ b/challenges/train.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# Launch DeepSeek-V2-Lite from-scratch training with PithTrain.
+
+set -euo pipefail
+source pith-train/.venv/bin/activate
+
+# Hide host libcudart.so.12 so cuDNN loads only cu13 (avoids "Multiple libcudart").
+CUDART_SHIM=/tmp/cudart12-shim
+mkdir -p $CUDART_SHIM && : > $CUDART_SHIM/libcudart.so.12
+export LD_LIBRARY_PATH=$CUDART_SHIM${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
+
+OUTPUT=artifacts/train-$(date +%Y%m%d-%H%M%S).log
+mkdir -p $(dirname $OUTPUT) ; exec > >(tee -a $OUTPUT) 2>&1
+trap 'echo "exit-time: $(date +%Y%m%d-%H%M%S)" >> "$OUTPUT"' EXIT INT TERM
+
+LAUNCH_ARGS=()
+LAUNCH_ARGS+=(--nnodes=${SLURM_NNODES:-1} --node-rank=${SLURM_NODEID:-0} --nproc-per-node=gpu)
+LAUNCH_ARGS+=(--rdzv-backend=c10d --rdzv-endpoint=${SLURM_LAUNCH_NODE_IPADDR:-localhost}:15213)
+
+export OMP_NUM_THREADS=8; export PYTHONUNBUFFERED=1; export PYTHONPATH=$PWD/pith-train
+torchrun ${LAUNCH_ARGS[@]} pith-train/challenges/train_config.py
diff --git a/challenges/train_config.py b/challenges/train_config.py
new file mode 100644
index 0000000..f337774
--- /dev/null
+++ b/challenges/train_config.py
@@ -0,0 +1,27 @@
+from pathlib import Path
+
+from pithtrain.tasks.pretrain_language_model import PretrainLanguageModelCfg, launch
+
+cfg = PretrainLanguageModelCfg()
+
+distributed = cfg.distributed
+distributed.pipeline_parallel_size = 4
+distributed.expert_parallel_size = 2
+
+training = cfg.training
+training.model = Path("pith-train/challenges/model_config.json")
+training.optimizer = "Adam"
+training.scheduler = "Constant"
+training.max_lr = 1.0e-4
+training.min_lr = 1.0e-4
+training.warmup_steps = 0
+training.max_steps = 64
+training.micro_batch_size = 1
+training.global_batch_size = 1024
+training.sequence_length = 2048
+training.dataset = Path("datasets/dclm-baseline/toktxt")
+training.moe_load_balance_type = "sequence"
+training.moe_load_balance_coef = 1e-2
+
+if __name__ == "__main__":
+    launch(cfg)
