+@contextlib.contextmanager
+def maybe_enable_nsys(
+    *,
+    current_step: int,
+    profile_step: int | None,
+    sync_group: dist.ProcessGroup | None,
+):
+    """Bracket one complete training step with the CUDA profiler API.
+
+    Nsight Systems can use these calls as capture triggers. A CPU-only Gloo
+    group coordinates every rank without adding synchronization kernels to the
+    measured GPU workload.
+    """
+    if profile_step is None or current_step != profile_step:
+        yield
+        return
+
+    assert sync_group is not None
+    dist.barrier(group=sync_group)
+    torch.cuda.synchronize()
+    torch.cuda.profiler.start()
+    dist.barrier(group=sync_group)
+    torch.cuda.nvtx.range_push(f"train_step_{current_step}")
+    logger.info("Nsight Systems capture started for step %d", current_step)
+
+    try:
+        yield
+    finally:
+        torch.cuda.nvtx.range_pop()
+        torch.cuda.synchronize()
+        dist.barrier(group=sync_group)
+        torch.cuda.profiler.stop()
+        logger.info("Nsight Systems capture stopped after step %d", current_step)
+
+
